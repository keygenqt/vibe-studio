{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-capability",
  "description": "Vibe Studio default permissions",
  "platforms": ["macOS", "linux"],
  "windows": ["*"],
  "permissions": [
    "core:default",
    "log:default",
    "dialog:default",
    "opener:default",
    "core:window:default",
    "core:window:allow-start-dragging"
  ]
}
