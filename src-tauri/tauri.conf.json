{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "vibe-studio",
  "mainBinaryName": "vibe-studio",
  "version": "0.0.1",
  "identifier": "com.keygenqt.vibe-studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3030",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1250,
        "height": 700,
        "minWidth": 900,
        "minHeight": 500,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "transparent": true
      }
    ],
    "withGlobalTauri": false,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": ["deb", "dmg"],
    "licenseFile": "LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
